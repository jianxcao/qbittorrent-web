## 最佳实践

### 1. 避免重复代码

```typescript
// ❌ 错误：重复的请求逻辑
export function pauseTorrent(hash: string) {
  return httpClient.post('/api/torrents/pause', { hashes: hash })
}
export function resumeTorrent(hash: string) {
  return httpClient.post('/api/torrents/resume', { hashes: hash })
}

// ✅ 正确：提取通用逻辑
function torrentAction(action: string, hash: string) {
  return httpClient.post(`/api/torrents/${action}`, { hashes: hash })
}
export const pauseTorrent = (hash: string) => torrentAction('pause', hash)
export const resumeTorrent = (hash: string) => torrentAction('resume', hash)
```

### 2. 使用常量管理 API 路径

```typescript
// ✅ 定义 API 路径常量
const API_PATHS = {
  TORRENTS: '/api/torrents',
  TORRENT_PAUSE: '/api/torrents/pause',
  TORRENT_RESUME: '/api/torrents/resume',
} as const

export function getTorrents() {
  return httpClient.get(API_PATHS.TORRENTS)
}
```

### 3. 合理使用缓存

```typescript
// ✅ 对频繁请求的数据使用缓存
let cachedCategories: Category[] | null = null

export async function getCategories(forceRefresh = false): Promise<Category[]> {
  if (!forceRefresh && cachedCategories) {
    return cachedCategories
  }
  
  const { data } = await httpClient.get('/api/categories')
  cachedCategories = data
  return data
}
```
