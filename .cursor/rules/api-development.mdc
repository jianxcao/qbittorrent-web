### 泛型 API 响应

```typescript
// ✅ 使用泛型封装通用响应格式
export interface ApiResponse<T> {
  code: number
  message: string
  data: T
}

export async function fetchData<T>(url: string): Promise<T> {
  const { data } = await httpClient.get<ApiResponse<T>>(url)
  return data.data
}
```

## 请求数据格式化

### FormData 处理

```typescript
// ✅ 使用辅助函数处理 FormData
export function toFormData(obj: Record<string, any>): FormData {
  const formData = new FormData()
  Object.entries(obj).forEach(([key, value]) => {
    if (value !== undefined && value !== null) {
      formData.append(key, value)
    }
  })
  return formData
}

// 使用示例
export async function uploadTorrent(file: File, params: {
  savepath?: string
  category?: string
}): Promise<void> {
  const formData = toFormData({
    torrents: file,
    ...params
  })
  await httpClient.post('/api/torrents/add', formData)
}
```

### URL 编码处理

```typescript
// ✅ 使用辅助函数处理 URL 编码
export function toUrlEncoded(obj: Record<string, any>): string {
  return new URLSearchParams(obj).toString()
}

// 使用示例
export async function login(username: string, password: string): Promise<void> {
  await httpClient.post(
    '/api/auth/login',
    toUrlEncoded({ username, password }),
    {
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
    }
  )
}
```

