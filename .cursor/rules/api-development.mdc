# API 层开发规范

## 文件组织

```
src/api/
├── modules/           # 按功能模块组织
│   ├── torrent.ts    # 种子相关 API
│   ├── setting.ts    # 设置相关 API
│   └── session.ts    # 会话相关 API
├── http.ts           # HTTP 客户端配置
├── types.ts          # API 类型定义
└── index.ts          # 统一导出
```

## API 函数定义

### 命名规范

```typescript
// ✅ 使用动词 + 名词的命名方式
export function getTorrents() { }
export function createTorrent() { }
export function updateTorrent() { }
export function deleteTorrent() { }
export function pauseTorrents() { }
export function resumeTorrents() { }
```

### 函数签名

```typescript
// ✅ 明确的参数和返回类型
export async function getTorrentList(params: {
  filter?: string
  category?: string
  tag?: string
}): Promise<Torrent[]> {
  const { data } = await httpClient.get('/api/torrents', { params })
  return data
}

// ✅ 使用可选参数简化调用
export async function deleteTorrent(
  hash: string,
  deleteFiles = false
): Promise<void> {
  await httpClient.post('/api/torrents/delete', {
    hashes: hash,
    deleteFiles
  })
}
```

## 错误处理

### 统一错误处理模式

```typescript
// ✅ 在 API 函数中捕获并重新抛出错误
export async function updateTorrentCategory(
  hash: string,
  category: string
): Promise<void> {
  try {
    await httpClient.post('/api/torrents/setCategory', {
      hashes: hash,
      category
    })
  } catch (error) {
    console.error('Failed to update category:', error)
    throw error
  }
}
```

### HTTP 拦截器处理

```typescript
// ✅ 全局拦截器处理通用错误
httpClient.interceptors.response.use(
  (response) => response,
  async (error) => {
    const { response } = error
    
    // 403 自动跳转登录
    if (response?.status === 403) {
      if (window.router.currentRoute.value.path !== '/login') {
        window.router.push('/login')
      }
    }
    
    return Promise.reject(error)
  }
)
```

