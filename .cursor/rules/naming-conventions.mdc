# 命名规范

## 文件命名

### Vue 组件

```bash
# ✅ 使用 PascalCase
CanvasList.vue
AppHeader.vue
TorrentItem.vue
SiderbarView.vue

# ❌ 避免
canvas-list.vue
torrent_item.vue
torrentitem.vue
```

### TypeScript 文件

```bash
# ✅ Composables: use + PascalCase
useColumns.ts
useTorrentActions.ts
useWebSocket.ts

# ✅ 工具函数: camelCase
formatSpeed.ts
parseSize.ts
sortTorrents.ts

# ✅ 类型定义: PascalCase 或描述性名称
types.ts
TorrentTypes.ts
api-types.ts

# ✅ Store: camelCase with use prefix
torrent.ts  (export useTorrentStore)
setting.ts  (export useSettingStore)
```

### 目录

```bash
# ✅ 使用 kebab-case
api-client/
torrent-list/
user-settings/

# ❌ 避免
apiClient/
TorrentList/
user_settings/
```

## 变量命名

### 常规变量

```typescript
// ✅ 使用 camelCase
const torrentList = ref<Torrent[]>([])
const isLoading = ref(false)
const downloadSpeed = ref(0)

// ❌ 避免
const TorrentList = ref([])
const is_loading = ref(false)
const download_speed = ref(0)
```

### 布尔变量

```typescript
// ✅ 使用 is/has/should/can 前缀
const isLoading = ref(false)
const hasError = ref(false)
const shouldShow = ref(true)
const canEdit = computed(() => user.value?.role === 'admin')

// ❌ 避免
const loading = ref(false)
const error = ref(false)
const show = ref(true)
```

### 常量

```typescript
// ✅ 使用 UPPER_SNAKE_CASE 表示常量
const MAX_RETRY_COUNT = 3
const DEFAULT_PAGE_SIZE = 20
const API_BASE_URL = 'https://api.example.com'

// ✅ 对象常量使用 camelCase
const defaultSettings = {
  theme: 'light',
  language: 'en-US'
} as const

// ❌ 避免
const maxRetryCount = 3
const default_page_size = 20
```

### 枚举

```typescript
// ✅ 枚举名使用 PascalCase，值使用 UPPER_SNAKE_CASE
enum TorrentState {
  DOWNLOADING = 'downloading',
  UPLOADING = 'uploading',
  PAUSED_DL = 'pausedDL',
  PAUSED_UP = 'pausedUP'
}

// ✅ 或使用对象常量
const TorrentState = {
  DOWNLOADING: 'downloading',
  UPLOADING: 'uploading',
  PAUSED_DL: 'pausedDL'
} as const
```

## 函数命名

### 普通函数

```typescript
// ✅ 使用动词开头的 camelCase
function formatSpeed(bytes: number): string { }
function calculateProgress(downloaded: number, total: number): number { }
function sortTorrents(torrents: Torrent[]): Torrent[] { }

// ❌ 避免
function speed_format() { }
function CalculateProgress() { }
function torrents() { }
```

### 事件处理函数

```typescript
// ✅ 使用 handle + 动作 + 对象
function handleDeleteTorrent() { }
function handlePauseClick() { }
function handleFilterChange() { }

// ✅ 或使用 on + 动作
function onDelete() { }
function onPause() { }
function onFilterChange() { }

// ❌ 避免
function deleteTorrent() { } // 与业务逻辑函数混淆
function click() { }
```

### Composables

```typescript
// ✅ 使用 use 前缀
export function useColumns() { }
export function useTorrentActions() { }
export function useWebSocket() { }

// ❌ 避免
export function columns() { }
export function torrentActions() { }
```

### API 函数

```typescript
// ✅ 使用 RESTful 动词
export function getTorrents() { }
export function createTorrent() { }
export function updateTorrent() { }
export function deleteTorrent() { }

// ✅ 或使用更具体的动词
export function fetchTorrents() { }
export function pauseTorrent() { }
export function resumeTorrent() { }

// ❌ 避免模糊的命名
export function torrents() { }
export function doSomething() { }
```

## 类型命名

### Interfaces

```typescript
// ✅ 使用 PascalCase
interface Torrent {
  hash: string
  name: string
  size: number
}

interface TorrentListParams {
  filter?: string
  category?: string
}

// ❌ 避免 I 前缀（不是 C# 风格）
interface ITorrent { }
```

### Type Aliases

```typescript
// ✅ 使用 PascalCase
type TorrentState = 'downloading' | 'uploading' | 'paused'
type ID = string | number
type Callback = (data: any) => void

// ✅ 使用描述性后缀
type TorrentStateUnion = 'downloading' | 'uploading' | 'paused'
type HttpMethod = 'GET' | 'POST' | 'PUT' | 'DELETE'
```

### 泛型

```typescript
// ✅ 单字母或描述性名称
function identity<T>(value: T): T { }
function map<TInput, TOutput>(items: TInput[], fn: (item: TInput) => TOutput): TOutput[] { }

interface ApiResponse<TData> {
  data: TData
  message: string
}

// ❌ 避免
function identity<Type>(value: Type): Type { }
```

## 组件命名

### Props

```typescript
// ✅ 使用 Props 接口
interface TorrentItemProps {
  torrent: Torrent
  showActions?: boolean
}

const props = defineProps<TorrentItemProps>()

// ✅ 或使用 withDefaults
interface Props {
  torrent: Torrent
  showActions?: boolean
}

const props = withDefaults(defineProps<Props>(), {
  showActions: true
})
```

### Emits

```typescript
// ✅ 使用 Emits 接口
interface TorrentItemEmits {
  (e: 'delete', hash: string): void
  (e: 'pause', hash: string): void
}

const emit = defineEmits<TorrentItemEmits>()

// ✅ 或简化版
interface Emits {
  (e: 'update:modelValue', value: string): void
}

const emit = defineEmits<Emits>()
```

### Refs

```typescript
// ✅ 使用 Ref 后缀
const inputRef = ref<HTMLInputElement>()
const dialogRef = ref<InstanceType<typeof NDialog>>()
const scrollerRef = ref<HTMLDivElement>()

// ❌ 避免
const input = ref<HTMLInputElement>()
const dialog = ref()
```

## Store 命名

### Store 定义

```typescript
// ✅ 使用 use + 名词 + Store
export const useTorrentStore = defineStore('torrent', () => { })
export const useSettingStore = defineStore('setting', () => { })
export const useSessionStore = defineStore('session', () => { })

// ❌ 避免
export const torrentStore = defineStore('torrent', () => { })
export const useTorrents = defineStore('torrent', () => { })
```

### Store State

```typescript
// ✅ 描述性名称
const torrents = ref<Torrent[]>([])
const isLoadingList = ref(false)
const selectedHashes = ref<Set<string>>(new Set())

// ❌ 避免过于简短
const data = ref([])
const loading = ref(false)
const selected = ref(new Set())
```

### Store Actions

```typescript
// ✅ 使用动词开头
async function fetchTorrents() { }
async function pauseTorrent(hash: string) { }
function updateFilter(filter: string) { }

// ❌ 避免 get/set 前缀（除非真的是简单的 getter/setter）
async function getTorrents() { } // 使用 fetchTorrents
function setFilter() { }         // 使用 updateFilter
```

## CSS 类名

### 使用 BEM 命名

```less
// ✅ Block__Element--Modifier
.torrent-item {
  &__name { }
  &__progress { }
  &--downloading { }
  &--paused { }
}

// 编译为:
// .torrent-item
// .torrent-item__name
// .torrent-item__progress
// .torrent-item--downloading
// .torrent-item--paused
```

### UnoCSS 工具类

```vue
<!-- ✅ 使用语义化的工具类组合 -->
<div class="flex items-center gap-2 p-4 rounded-lg bg-white shadow-sm">
  <span class="text-sm font-medium text-gray-700">{{ name }}</span>
</div>
```

## 命名原则总结

1. **一致性**: 整个项目保持一致的命名风格
2. **描述性**: 名称应清晰表达意图，避免缩写
3. **简洁性**: 在描述性和简洁性之间取得平衡
4. **可读性**: 优先考虑代码可读性
5. **遵循社区惯例**: 遵循 Vue/TypeScript 社区的最佳实践

```typescript
// ✅ 好的命名示例
const isLoadingTorrentList = ref(false)
const downloadingTorrents = computed(() => torrents.value.filter(t => t.state === 'downloading'))
async function fetchTorrentsByCategory(category: string) { }

// ❌ 不好的命名示例
const loading = ref(false)  // 缺少上下文
const list = computed(() => data.value.filter(x => x.s === 'd'))  // 不清晰
async function get(c: string) { }  // 过于简短
```
